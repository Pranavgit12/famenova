PORT=5000
JWT_SECRET=change-me-to-a-strong-random-string
JWT_EXPIRES_IN=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

NOTIFY_EMAIL=notifications@rexagency.com

EXCEL_PATH=./dataset/leads.xlsx

# Google Calendar (booking system)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/booking/callback
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_ACCESS_TOKEN=set-after-oauth
GOOGLE_REFRESH_TOKEN=set-after-oauth
