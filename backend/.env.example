PORT=5000
NODE_ENV=development

# Optional. When set, leads and users are stored in PostgreSQL (recommended for Vercel).
# When empty, storage falls back to Excel (dataset/leads.xlsx) + users.json for local dev.
# Supabase example: postgresql://postgres:<password>@db.example.supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL=

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# JWT - REQUIRED. Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-64-char-random-hex-string
JWT_EXPIRES_IN=12h

# Initial admin account (only used on first boot when backend/users.json is missing)
ADMIN_EMAIL=admin@rexagency.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

NOTIFY_EMAIL=notifications@rexagency.com

EXCEL_PATH=./dataset/leads.xlsx
