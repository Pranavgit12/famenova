# Server
PORT=5000
NODE_ENV=production

# Optional. When set, leads and users are stored in PostgreSQL (recommended for Vercel).
# When empty, storage falls back to Excel (dataset/leads.xlsx) + users.json.
# Supabase example: postgresql://postgres:<password>@db.example.supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL=

# Comma-separated list of allowed browser origins (e.g. https://yourdomain.com,https://admin.yourdomain.com)
# REQUIRED in production - the server will refuse to start without it.
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com

# JWT - REQUIRED. Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-64-char-random-hex-string
JWT_EXPIRES_IN=12h

# Initial admin account (only used on first boot when backend/users.json is missing)
# REQUIRED in production - the server will refuse to start without ADMIN_PASSWORD.
ADMIN_EMAIL=admin@rexagency.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Email (Gmail App Password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rexagency0@gmail.com
SMTP_PASS=replace-with-your-app-password

# Notifications sent to
NOTIFY_EMAIL=rexagency0@gmail.com

# Excel dataset path (relative to backend root)
EXCEL_PATH=./dataset/leads.xlsx
